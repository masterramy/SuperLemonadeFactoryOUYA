+def replace_second_of_two_norm(text,before,after,label):
+    """Fail-closed replacement for the reviewed duplicate where the later copy is authoritative."""
+    if before==after:
+        return text,False
+    # Once the later reviewed copy has been changed, exactly one AFTER and one untouched BEFORE remain.
+    if after:
+        _, aa=find_norm_windows(text,after)
+        _, bb=find_norm_windows(text,before)
+        if len(aa)==1 and len(bb)==1:
+            return text,False
+    lines,bb=find_norm_windows(text,before)
+    if len(bb)!=2:
+        raise ApplyError(f"{label}: expected exactly two reviewed BEFORE blocks, found {len(bb)}")
+    ss,ee=bb[1]
+    repl=after.replace("\r\n","\n").split("\n") if after else []
+    return "\n".join(lines[:ss]+repl+lines[ee:]),True
+
